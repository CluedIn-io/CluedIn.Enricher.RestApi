<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="CluedIn.CrawlerIntegrationTesting.$(_CluedInPackageSuffix)" />
    <PackageReference Include="CluedIn.Testing.Base.$(_CluedInPackageSuffix)" />
  </ItemGroup>
  <!-- xunit v3 + AutoFixture.Xunit3 for net10.0 (CluedIn 5.0+) -->
  <ItemGroup Condition="$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AutoFixture.Xunit3" />
  </ItemGroup>
  <!-- xunit v2 + AutoFixture.Xunit2 for net6.0 (CluedIn < 5.0) -->
  <ItemGroup Condition="!$(DefineConstants.Contains('CLUEDIN_V50'))">
    <PackageReference Include="xunit" />
    <PackageReference Include="AutoFixture.Xunit2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sample Process Scripts under docs/samples, run by the tests in Samples/ -->
    <EmbeddedResource Include="..\..\..\docs\samples\vies-vat-validation\vies-process-script.js" Link="Samples\vies-process-script.js" LogicalName="Samples.vies-process-script.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ExternalSearch.Providers.RestApi\ExternalSearch.Providers.RestApi.csproj" />
  </ItemGroup>
</Project>